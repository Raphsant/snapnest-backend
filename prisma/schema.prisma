generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PERSONAL
  AGENCY_CLIENT
  AGENCY_STAFF
  ADMIN
}

enum FolderType {
  PERSONAL
  AGENCY_INTAKE
  AGENCY_RAW
  AGENCY_PRODUCED
  APPROVED
  REJECTED
  NEEDS_MODIFICATIONS
}

enum FileSource {
  CAMERA
  GALLERY
  PIPELINE
}

enum FileType {
  PHOTO
  VIDEO
  AUDIO
  TRANSCRIPT
  SUBTITLE
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_MODIFICATIONS
}

enum JobStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PipelineJobStatus {
  QUEUED
  RUNNING
  AWAITING_MANIFEST_APPROVAL
  APPROVED
  AWAITING_CREATIVE_APPROVAL
  CREATIVE_APPROVED
  COMPLETED
  FAILED
}

enum PipelineSourceType {
  FILE
  YOUTUBE
}

enum AgencyRole {
  CLIENT
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum IntakeSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  PROCESSING
  COMPLETE
}

model User {
  id          String      @id @default(uuid())
  cognitoSub  String      @unique
  email       String      @unique
  firstName   String?
  accountType AccountType @default(PERSONAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  folders     Folder[]
  files       MediaFile[]
  uploadJobs   UploadJob[]
  pipelineJobs PipelineJob[]
  memberships  AgencyMembership[]
  pushTokens   PushToken[]
  ndaAcceptances NdaAcceptance[]
  intakeSessions IntakeSession[]

  @@index([cognitoSub])
}

model Agency {
  id        String   @id @default(uuid())
  name      String
  ndaText    String?
  ndaVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships AgencyMembership[]
  folders      Folder[]
  files        MediaFile[]
  pipelineJobs PipelineJob[]
  ndaAcceptances NdaAcceptance[]
  intakePrograms IntakeProgram[]
  intakeSessions IntakeSession[]
}

model AgencyMembership {
  id        String     @id @default(uuid())
  agencyId  String
  userId    String
  role      AgencyRole @default(CLIENT)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
  @@index([agencyId])
  @@index([userId, status])
}

model Folder {
  id             String     @id @default(uuid())
  ownerId        String
  agencyId       String?
  name           String
  type           FolderType @default(PERSONAL)
  isSystem       Boolean    @default(false)
  captureSeq     Int        @default(0)
  parentFolderId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agency   Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  parent   Folder?    @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children Folder[]   @relation("FolderHierarchy")
  files    MediaFile[]
  intakeSessions IntakeSession[]

  @@index([ownerId])
  @@index([agencyId])
  @@index([parentFolderId])
}

model MediaFile {
  id             String       @id @default(uuid())
  ownerId        String
  agencyId       String?
  folderId       String?
  fileName       String
  displayName    String?
  mimeType       String
  sizeBytes      BigInt
  s3Key          String       @unique
  fileType       FileType
  source         FileSource
  uploadStatus   UploadStatus @default(PENDING)
  reviewStatus   ReviewStatus?
  durationSeconds Int?
  thumbnailS3Key String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agency    Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadJob    UploadJob?
  pipelineJobs PipelineJob[]
  intakeAnswers IntakeAnswer[]

  @@index([ownerId])
  @@index([agencyId])
  @@index([folderId])
  @@index([ownerId, createdAt(sort: Desc)])
}

model UploadJob {
  id           String    @id @default(uuid())
  userId       String
  fileId       String    @unique
  status       JobStatus @default(REQUESTED)
  expiresAt    DateTime
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  file MediaFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model PipelineJob {
  id            String             @id @default(uuid())
  sourceType    PipelineSourceType @default(FILE)
  sourceFileId  String?
  sourceUrl     String?
  sourceS3Key   String?
  agencyId      String?
  requestedById String
  status        PipelineJobStatus  @default(QUEUED)
  currentStage  String?
  error         String?
  manifest      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  sourceFile  MediaFile? @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  agency      Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  requestedBy User       @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  intakeAnswer IntakeAnswer?

  @@index([sourceFileId])
  @@index([agencyId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model PipelineDelivery {
  id        String   @id @default(uuid())
  jobId     String
  clipId    String
  fileId    String   // delivered MediaFile
  folderId  String
  createdAt DateTime @default(now())

  @@unique([jobId, clipId, folderId])
}

/// Marks an assembled pipeline output as published to social.
///
/// Keyed on (jobId, clipId) — the output itself — not on PipelineDelivery,
/// because one clip may be delivered to several folders and "posted" is a
/// property of the creative, not of any one delivery. Row presence IS the
/// posted state: clearing deletes the row, so there is no null-vs-missing
/// ambiguity. Outputs live only in S3, so nothing here is a foreign key —
/// same shape as PipelineDelivery above.
model PipelineOutputPost {
  id        String   @id @default(uuid())
  jobId     String
  clipId    String
  postedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, clipId])
  @@index([postedAt])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NdaAcceptance {
  id         String   @id @default(uuid())
  agencyId   String
  userId     String
  version    String
  fullName   String
  acceptedAt DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId, version])
  @@index([userId])
}

model IntakeProgram {
  id        String   @id @default(uuid())
  agencyId  String
  title     String
  version   Int      @default(1)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  steps    IntakeStep[]
  sessions IntakeSession[]

  @@index([agencyId, isActive])
}

model IntakeStep {
  id                   String   @id @default(uuid())
  programId            String
  order                Int
  title                String
  explainerS3Key       String
  explainerDurationSec Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  program   IntakeProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  questions IntakeQuestion[]
  progress  IntakeStepProgress[]

  @@unique([programId, order])
}

model IntakeQuestion {
  id             String   @id @default(uuid())
  stepId         String
  order          Int
  prompt         String
  maxDurationSec Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  step    IntakeStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  answers IntakeAnswer[]

  @@unique([stepId, order])
}

model IntakeSession {
  id              String              @id @default(uuid())
  programId       String
  agencyId        String
  userId          String
  status          IntakeSessionStatus @default(NOT_STARTED)
  answersFolderId String
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  program       IntakeProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answersFolder Folder        @relation(fields: [answersFolderId], references: [id], onDelete: NoAction)
  stepProgress  IntakeStepProgress[]
  answers       IntakeAnswer[]

  @@unique([programId, userId])
  @@index([agencyId, status])
}

model IntakeStepProgress {
  id             String    @id @default(uuid())
  sessionId      String
  stepId         String
  watchedSeconds Int       @default(0)
  watchedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step    IntakeStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepId])
}

model IntakeAnswer {
  id            String   @id @default(uuid())
  sessionId     String
  questionId    String
  fileId        String
  pipelineJobId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session     IntakeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question    IntakeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  file        MediaFile      @relation(fields: [fileId], references: [id], onDelete: NoAction)
  pipelineJob PipelineJob?   @relation(fields: [pipelineJobId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId])
  @@index([fileId])
}
